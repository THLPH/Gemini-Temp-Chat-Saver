{
  "manifest_version": 3,
  "name": "Gemini Temp Saver",
  "version": "3.0",
  "description": "Local cache and export utility for Gemini temporary chats.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "activeTab", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-temp-saver@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Saver",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"]
    }
  ]
}